    {
        "id": "b7f0b6a8d8e3c101",
        "type": "function",
        "z": "18f99e3a39e8316a",
        "name": "Evaluar y preparar datos",
        "func": "const temperatura = Number(msg.payload);\nconst topic = msg.topic || '';\n\nif (!Number.isFinite(temperatura)) {\n    return null;\n}\n\nif (topic.endsWith('/temperatura')) {\n    flow.set('dht11_temperatura', temperatura);\n} else if (topic.endsWith('/humedad')) {\n    flow.set('dht11_humedad', temperatura);\n} else {\n    return null;\n}\n\nconst temp = flow.get('dht11_temperatura');\nconst hum = flow.get('dht11_humedad');\nif (!Number.isFinite(temp) || !Number.isFinite(hum)) {\n    return null;\n}\n\nconst timestamp = Math.floor(Date.now() / 1000);\nconst alertas = [];\nif (temp < 18 || temp > 30) {\n    alertas.push(`Temperatura fuera de rango: ${temp.toFixed(2)} °C`);\n}\nif (hum < 40 || hum > 80) {\n    alertas.push(`Humedad fuera de rango: ${hum.toFixed(2)} %`);\n}\n\nlet telegramMsg = null;\nconst telegramToken = env.get('TELEGRAM_BOT_TOKEN');\nconst telegramChatId = env.get('TELEGRAM_CHAT_ID');\nif (alertas.length > 0 && telegramToken && telegramChatId) {\n    telegramMsg = {\n        method: 'GET',\n        url: `https://api.telegram.org/bot${telegramToken}/sendMessage?chat_id=${encodeURIComponent(telegramChatId)}&text=${encodeURIComponent(`Alerta DHT11 - ${alertas.join(' - ')} - Hora: ${new Date().toISOString()}`)}`,\n        headers: {}\n    };\n} else if (alertas.length > 0) {\n    node.warn('Faltan TELEGRAM_BOT_TOKEN o TELEGRAM_CHAT_ID; no se envio la alerta.');\n}\n\nlet influxMsg = null;\nconst influxUrl = env.get('INFLUXDB_URL');\nconst influxOrg = env.get('INFLUXDB_ORG');\nconst influxBucket = env.get('INFLUXDB_BUCKET');\nconst influxToken = env.get('INFLUXDB_TOKEN');\nif (influxUrl && influxOrg && influxBucket && influxToken) {\n    influxMsg = {\n        method: 'POST',\n        url: `${influxUrl.replace(/\\/$/, '')}/api/v2/write?org=${encodeURIComponent(influxOrg)}&bucket=${encodeURIComponent(influxBucket)}&precision=s`,\n        headers: {\n            Authorization: `Token ${influxToken}`,\n            'Content-Type': 'text/plain; charset=utf-8'\n        },\n        payload: `dht11,ubicacion=comedor temperatura=${temp},humedad=${hum} ${timestamp}`\n    };\n} else {\n    node.warn('Faltan INFLUXDB_URL, INFLUXDB_ORG, INFLUXDB_BUCKET o INFLUXDB_TOKEN; no se guardaron los datos.');\n}\n\nreturn [telegramMsg, influxMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
